{
  "name": "buffalo-projects-tools",
  "version": "2.0.1",
  "type": "module",
  "description": "Free MCP tools that turn one resume into evidence-backed applications for jobs from the Buffalo Projects index.",
  "keywords": [
    "buffalo",
    "western-new-york",
    "mcp",
    "model-context-protocol",
    "claude",
    "codex",
    "jobs",
    "careers",
    "resume",
    "auto-apply",
    "accelerators"
  ],
  "bin": {
    "buffalo-projects-tools": "dist/index.js",
    "buffalo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.16.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.1.0",
      "body-parser": "2.3.0",
      "fast-uri": "3.1.5",
      "hono": "4.13.1",
      "ip-address": "10.5.0"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "catalog:verify": "tsx scripts/verify-catalog.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "prepare": "tsup",
    "smoke": "node dist/index.js --check",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jszip": "3.10.1",
    "mammoth": "1.12.1",
    "pdf-parse": "2.4.5",
    "pdfkit": "0.19.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "0.17.6",
    "node-html-parser": "9.0.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhinehart514/buffalo-projects-tools.git"
  },
  "bugs": {
    "url": "https://github.com/rhinehart514/buffalo-projects-tools/issues"
  },
  "homepage": "https://github.com/rhinehart514/buffalo-projects-tools#readme",
  "license": "MIT"
}
